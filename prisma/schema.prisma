// Ademicon Prospect AI — modelo de dados V1
// Regra de ouro: todo registro de negócio carrega organizationId (multi-tenant).
// Valores monetários em reais inteiros (Int) para simplificar a V1.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ───────────────────────── Organização, usuários e acesso ─────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  slug      String   @unique
  logoUrl   String?
  timezone  String   @default("America/Sao_Paulo")
  locale    String   @default("pt-BR")
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  roles         Role[]
  regions       Region[]
  pjs           PJ[]
  consultants   Consultant[]
  leads         Lead[]
  campaigns     Campaign[]
  opportunities Opportunity[]
  conversations Conversation[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String    @unique
  passwordHash   String
  roleId         String
  pjId           String?
  consultantId   String?   @unique
  status         String    @default("ACTIVE") // ACTIVE | INVITED | DISABLED
  mfaEnabled     Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id])
  role                   Role                    @relation(fields: [roleId], references: [id])
  pj                     PJ?                     @relation(fields: [pjId], references: [id])
  consultant             Consultant?             @relation(fields: [consultantId], references: [id])
  sessions               Session[]
  notifications          Notification[]
  devices                UserDevice[]
  notificationPreference NotificationPreference?

  @@index([organizationId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String // SUPER_ADMIN | ADMIN | MANAGER | MARKETING | AI_ADMIN | PJ_MANAGER | CONSULTANT | AUDITOR
  name           String
  description    String?
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // ex.: lead.read
  module      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String
  keyHash        String    @unique
  permissions    String[]
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
}

// ───────────────────────── Estrutura comercial ─────────────────────────

model Region {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  ufs            String[]
  cities         String[]
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  pjs          PJ[]

  @@unique([organizationId, name])
}

model PJ {
  id                 String   @id @default(cuid())
  organizationId     String
  regionId           String?
  code               String
  name               String
  city               String
  uf                 String
  citiesServed       String[]
  active             Boolean  @default(true)
  // Landing própria da PJ (serviço apps/landing): <subdomain>.<LANDING_BASE_DOMAIN>
  subdomain          String?  @unique
  landingActive      Boolean  @default(false)
  landingTitle       String?
  landingSubtitle    String?
  landingSimulatorId String?
  // Contato da unidade exibido na landing (WhatsApp / ligar / endereço)
  phone              String?
  whatsapp           String?
  address            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id])
  region        Region?       @relation(fields: [regionId], references: [id])
  consultants   Consultant[]
  users         User[]
  leads         Lead[]
  opportunities Opportunity[]

  @@unique([organizationId, code])
  @@index([organizationId, regionId])
}

model Consultant {
  id                   String   @id @default(cuid())
  organizationId       String
  pjId                 String
  name                 String
  email                String
  phone                String?
  products             String[] // especialidades (IMOVEL, VEICULO, ...)
  maxOpenLeads         Int      @default(30)
  maxOpenOpportunities Int      @default(40)
  workingHours         Json     @default("{}") // { days: [1..5], start: 8, end: 18 } — vazio = sem restrição
  available            Boolean  @default(true)
  active               Boolean  @default(true)
  priority             Int      @default(0)
  /// IA do consultor: { enabled, assistantName, presentation, style, signature, emojis } — vazio = padrão da organização
  aiProfile            Json     @default("{}")
  /// Divisão igual: quem entra (ou volta a ficar ativo) no meio do mês começa empatado com a equipe,
  /// e não recebe todos os próximos leads para "alcançar" os outros. Vale só no mês de splitBaselineAt.
  /// Link do Instagram do consultor (perfil profissional)
  instagramUrl         String?
  /// Conta do Instagram conectada pelo próprio consultor (uma por consultor). O id é o que chega nos webhooks.
  instagramAccountId   String?  @unique
  instagramUsername    String?
  instagramTokenEnc    String?
  instagramTokenExpiresAt DateTime?
  /// Link próprio do consultor (para a bio): <landingSlug>.<domínio>. Página idêntica à da Ademicon;
  /// quem chega por ele e deixa contato vira lead DESTE consultor.
  landingSlug          String?  @unique
  /// Foto do colaborador (chave no storage). Aparece só no sistema interno — nunca na página pública.
  photoKey             String?
  splitBaseline        Int      @default(0)
  splitBaselineAt      DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  pj              PJ               @relation(fields: [pjId], references: [id])
  user            User?
  leads           Lead[]
  opportunities   Opportunity[]
  whatsappNumbers WhatsAppNumber[]

  @@index([organizationId, pjId])
}

// ───────────────────────── Leads ─────────────────────────

enum LeadStatus {
  NEW
  PROCESSING
  QUALIFIED
  ASSIGNED
  IN_CONVERSATION
  OPPORTUNITY
  CONVERTED
  LOST
  BLOCKED
}

model Lead {
  id             String @id @default(cuid())
  organizationId String
  code           Int    @default(autoincrement())

  // Identidade
  name    String
  phone   String? // somente dígitos com DDI (ex.: 5511999990000)
  email   String?
  company String?
  cnpj    String?
  city    String?
  uf      String?

  // Interesse
  product      String? // IMOVEL | VEICULO | MOTO | SERVICOS | BENS_MOVEIS
  objective    String?
  desiredValue Int?
  term         String?
  region       String?

  // Origem
  source        String // GOOGLE_ADS | META | INSTAGRAM | WHATSAPP | LANDING | SIMULATOR | IMPORT | MAPS | API | MANUAL
  medium        String?
  campaignId    String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  landingPageId String?
  externalId    String?

  // Inteligência
  score               Int        @default(0)
  temperature         String     @default("FRIO") // FRIO (0–40) | MORNO (41–70) | QUENTE (71–100) — faixas configuráveis
  landingHeat         String? // Qualificação na landing da PJ: MORNO (simulou + deixou contato) | QUENTE (+ pediu para ser chamado agora)
  originPjId          String? // PJ dona da landing de origem — o lead fica nessa PJ
  routingHint         String? // CENTRAL = landing central (divisão igual entre PJs e consultores)
  intent              String? // LOW | MEDIUM | HIGH
  signals             Json       @default("{}") // { simulationStarted, requestedContact, repliedBot, highIntentReason }
  status              LeadStatus @default(NEW)
  lostReason          String?
  // Lead Intelligence V2 — sub-scores 0–100 (ver docs/lead-intelligence.md)
  fitScore            Int        @default(0)
  intentScore         Int        @default(0)
  engagementScore     Int        @default(0)
  behaviorScore       Int        @default(0)
  recencyScore        Int        @default(0)
  lifecycle           String     @default("ACTIVE") // ACTIVE | NURTURE | REACTIVATION | DORMANT
  lastSignalAt        DateTime?
  experimentVariantId String?

  // Distribuição
  pjId         String?
  consultantId String?
  assignedAt   DateTime?

  // IA
  aiSummary         String?
  lastAgent         String?
  lastInteractionAt DateTime?

  // Governança
  consentStatus    String   @default("UNKNOWN") // GRANTED | REVOKED | UNKNOWN
  preferredChannel String?
  optOut           Boolean  @default(false)
  dataOrigin       String? // descrição da base legal / origem do dado
  capturedAt       DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization             @relation(fields: [organizationId], references: [id])
  pj            PJ?                      @relation(fields: [pjId], references: [id])
  consultant    Consultant?              @relation(fields: [consultantId], references: [id])
  campaign      Campaign?                @relation(fields: [campaignId], references: [id])
  landingPage   LandingPage?             @relation(fields: [landingPageId], references: [id])
  identities    LeadIdentity[]
  sources       LeadSource[]
  merges        LeadMerge[]
  scoreSnapshot LeadScore?
  scoreEvents   LeadScoreEvent[]
  activities    LeadActivity[]
  opportunities Opportunity[]
  conversations Conversation[]
  memory        LeadMemory?
  consents      Consent[]
  preference    CommunicationPreference?
  tasks         Task[]
  simulations   Simulation[]
  buyingSignals BuyingSignal[]
  intentEvents  IntentEvent[]
  nextActions   NextBestAction[]

  @@unique([organizationId, code])
  @@index([organizationId, temperature])
  @@index([organizationId, lifecycle])
  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([organizationId, source])
  @@index([organizationId, campaignId])
  @@index([organizationId, pjId])
  @@index([organizationId, consultantId])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([phone])
  @@index([email])
  @@index([cnpj])
}

model LeadIdentity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  type           String // PHONE | EMAIL | CNPJ | EXTERNAL
  value          String
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, value])
  @@index([leadId])
}

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  source         String
  medium         String?
  campaignId     String?
  landingPageId  String?
  externalId     String?
  payload        Json     @default("{}")
  receivedAt     DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, source])
  @@index([leadId])
}

model LeadMerge {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  matchedBy      String // PHONE | EMAIL | CNPJ | EXTERNAL
  incoming       Json
  changes        Json
  mergedAt       DateTime @default(now())
  mergedBy       String // SYSTEM ou userId
  mergeReason    String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, mergedAt])
  @@index([leadId])
}

model LeadScore {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String   @unique
  score          Int
  temperature    String
  breakdown      Json
  computedAt     DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadScoreEvent {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  ruleKey        String
  points         Int
  reason         String
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadActivity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  type           String // CREATED | NOTE | STATUS_CHANGED | ASSIGNED | MERGED | SCORED | MESSAGE | HANDOFF | CALL | EMAIL | SIMULATION | OPPORTUNITY | CONSENT
  description    String
  actorType      String   @default("SYSTEM") // USER | SYSTEM | AI
  actorId        String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([leadId, createdAt])
}

// ───────────────────────── Aquisição ─────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  product        String?
  regionId       String?
  pjId           String?
  landingPageId  String?
  source         String // GOOGLE_ADS | META | INSTAGRAM | WHATSAPP | ORGANIC | EMAIL | OFFLINE
  status         CampaignStatus @default(DRAFT)
  startAt        DateTime?
  endAt          DateTime?
  budget         Int            @default(0)
  utmCampaign    String?
  externalId     String?
  /// Consultores que pagaram o anúncio: 1 = anúncio individual, vários = grupo, vazio = leads seguem a divisão geral.
  sponsorConsultantIds String[] @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  leads        Lead[]
  audiences    CampaignAudience[]
  messages     CampaignMessage[]
  events       CampaignEvent[]
  metrics      CampaignMetric[]

  @@index([organizationId, status])
  @@index([organizationId, source])
}

model CampaignAudience {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  name           String
  filters        Json     @default("{}")
  size           Int      @default(0)
  createdAt      DateTime @default(now())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignMessage {
  id             String    @id @default(cuid())
  organizationId String
  campaignId     String
  templateId     String?
  channel        String    @default("WHATSAPP")
  content        String
  scheduledAt    DateTime?
  status         String    @default("DRAFT") // DRAFT | QUEUED | SENDING | SENT | PAUSED
  sentCount      Int       @default(0)
  skippedCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignEvent {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  type           String
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model CampaignMetric {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  date           DateTime @db.Date
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  spend          Int      @default(0)
  providerLeads  Int      @default(0)
  provider       String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([organizationId, date])
}

model LandingPage {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  title          String
  subtitle       String?
  product        String?
  regionId       String?
  pjId           String?
  consultantId   String?
  ctaText        String   @default("Simular agora")
  imageUrl       String?
  benefits       Json     @default("[]")
  faq            Json     @default("[]")
  simulatorId    String?
  whatsappNumber String?
  tracking       Json     @default("{}")
  seo            Json     @default("{}")
  status         String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  form        LandingForm?
  simulator   Simulator?   @relation(fields: [simulatorId], references: [id])
  leads       Lead[]
  simulations Simulation[]

  @@index([organizationId, status])
}

model LandingForm {
  id             String      @id @default(cuid())
  organizationId String
  landingPageId  String      @unique
  fields         String[]
  requiredFields String[]
  consentText    String
  landingPage    LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model Simulator {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  slug               String   @unique
  products           Json // [{ key, label, termOptions: number[], adminFeePct, reserveFundPct, minValue, maxValue }]
  requiredFields     String[]
  parametersVerified Boolean  @default(false) // false = parâmetros ilustrativos (não oficiais)
  disclaimer         String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  landingPages LandingPage[]
  simulations  Simulation[]

  @@index([organizationId])
}

model Simulation {
  id                   String   @id @default(cuid())
  organizationId       String
  simulatorId          String
  leadId               String?
  landingPageId        String?
  attributionSessionId String?
  product              String
  objective            String?
  value                Int
  termMonths           Int?
  city                 String?
  uf                   String?
  result               Json     @default("{}")
  pjId                 String? // landing da PJ que gerou a simulação
  heat                 String? // FRIO (só simulou) | MORNO | QUENTE
  channel              String? // canal de origem (GOOGLE_ADS, GOOGLE_ORGANIC, META, ...)
  createdAt            DateTime @default(now())

  simulator   Simulator    @relation(fields: [simulatorId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  landingPage LandingPage? @relation(fields: [landingPageId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, pjId, createdAt])
}

// ───────────────────────── CRM / Oportunidades ─────────────────────────

model Pipeline {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  stages         PipelineStage[]
  opportunities  Opportunity[]

  @@index([organizationId])
}

model PipelineStage {
  id             String        @id @default(cuid())
  organizationId String
  pipelineId     String
  key            String // NOVO | QUALIFICADO | OPORTUNIDADE | CONTATO | NECESSIDADE | SIMULACAO | PROPOSTA | NEGOCIACAO | FECHADO | PERDIDO
  name           String
  order          Int
  isWon          Boolean       @default(false)
  isLost         Boolean       @default(false)
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]

  @@unique([pipelineId, key])
}

model Opportunity {
  id                  String    @id @default(cuid())
  organizationId      String
  code                Int       @default(autoincrement())
  leadId              String
  pipelineId          String
  stageId             String
  pjId                String?
  consultantId        String?
  product             String?
  value               Int       @default(0)
  source              String?
  campaignId          String?
  status              String    @default("OPEN") // OPEN | WON | LOST
  lostReason          String?
  lostCategory        String? // PRECO | CONCORRENTE | PRAZO | SEM_INTERESSE | SEM_CONTATO | DESISTENCIA | PRODUTO | OUTRO
  competitor          String?
  // Opportunity Intelligence (calculado por regra — ver docs/revenue-intelligence.md)
  health              String? // HEALTHY | AT_RISK | STALLED
  healthScore         Int?
  healthReasons       Json      @default("[]")
  stageChangedAt      DateTime  @default(now())
  lastActivityAt      DateTime?
  experimentVariantId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  closedAt            DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id])
  lead         Lead                  @relation(fields: [leadId], references: [id])
  pipeline     Pipeline              @relation(fields: [pipelineId], references: [id])
  stage        PipelineStage         @relation(fields: [stageId], references: [id])
  pj           PJ?                   @relation(fields: [pjId], references: [id])
  consultant   Consultant?           @relation(fields: [consultantId], references: [id])
  activities   OpportunityActivity[]
  tasks        Task[]

  @@unique([organizationId, code])
  @@index([organizationId, stageId])
  @@index([organizationId, status])
  @@index([organizationId, pjId])
  @@index([organizationId, consultantId])
  @@index([organizationId, campaignId])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
  @@index([organizationId, health])
  @@index([leadId])
}

model OpportunityActivity {
  id             String      @id @default(cuid())
  organizationId String
  opportunityId  String
  type           String // CREATED | STAGE_CHANGED | VALUE_CHANGED | NOTE | CLOSED_WON | CLOSED_LOST | REASSIGNED
  fromStage      String?
  toStage        String?
  description    String
  actorId        String?
  createdAt      DateTime    @default(now())
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  type           String // CONTACT | FOLLOW_UP | CALLBACK | PROPOSAL | MEETING
  title          String
  description    String?
  assigneeUserId String?
  consultantId   String?
  leadId         String?
  opportunityId  String?
  dueAt          DateTime
  priority       String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status         String       @default("OPEN") // OPEN | DONE | CANCELED
  origin         String       @default("MANUAL") // MANUAL | AUTOMATION | FOLLOW_UP
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([organizationId, status, dueAt])
  @@index([organizationId, consultantId])
}

// ───────────────────────── Conversas e IA ─────────────────────────

model Conversation {
  id                   String   @id @default(cuid())
  organizationId       String
  leadId               String
  channel              String   @default("WHATSAPP") // WHATSAPP | WEB
  whatsappNumberId     String?
  status               String   @default("OPEN") // OPEN | CLOSED
  mode                 String   @default("AI") // AI | HUMAN
  botState             String   @default("ACTIVE") // ACTIVE | PAUSED
  currentAgent         String? // PROSPECT | QUALIFICATION
  assignedConsultantId String?
  lastMessageAt        DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  lead         Lead                  @relation(fields: [leadId], references: [id])
  messages     Message[]
  summaries    ConversationSummary[]

  @@index([organizationId, lastMessageAt])
  @@index([organizationId, mode])
  @@index([leadId])
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  conversationId String
  direction      String // INBOUND | OUTBOUND
  senderType     String // LEAD | AI | HUMAN | SYSTEM
  agentKey       String?
  senderName     String?
  content        String
  status         String       @default("SENT") // QUEUED | SENT | DELIVERED | READ | FAILED | BLOCKED
  externalId     String?
  aiExecutionId  String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

