}

model PlaybookRun {
  id             String    @id @default(cuid())
  organizationId String
  playbookKey    String
  version        Int
  leadId         String
  stepIndex      Int       @default(0)
  status         String    @default("RUNNING") // RUNNING | WAITING | COMPLETED | CANCELLED | FAILED
  nextRunAt      DateTime?
  log            Json      @default("[]")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([organizationId, status, nextRunAt])
  @@index([leadId])
}

model AIPromptVersion {
  id             String    @id @default(cuid())
  organizationId String
  agentKey       String
  version        Int
  instructions   String
  model          String?
  temperature    Float?
  status         String    @default("DRAFT") // DRAFT | TESTING | ACTIVE | ARCHIVED
  changeNote     String?
  authorId       String?
  authorName     String?
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@unique([organizationId, agentKey, version])
  @@index([organizationId, agentKey, status])
}

model AIEvalDataset {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  kind           String // PROSPECTING | QUALIFICATION | OBJECTIONS | FOLLOW_UP | HANDOFF | SECURITY | KNOWLEDGE
  description    String?
  createdAt      DateTime     @default(now())
  cases          AIEvalCase[]
  runs           AIEvalRun[]

  @@index([organizationId])
}

model AIEvalCase {
  id             String        @id @default(cuid())
  organizationId String
  datasetId      String
  input          String
  // Expectativas verificáveis: { mustHandoff?, mustNotContain?: [], mustContainAny?: [], mustBlock?, expectGap? }
  expected       Json          @default("{}")
  tags           String[]
  dataset        AIEvalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model AIEvalRun {
  id             String        @id @default(cuid())
  organizationId String
  datasetId      String
  agentKey       String
  promptVersion  Int?
  status         String        @default("RUNNING") // RUNNING | COMPLETED | FAILED
  metrics        Json          @default("{}")
  results        Json          @default("[]")
  createdById    String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  dataset        AIEvalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AIInsight {
  id             String   @id @default(cuid())
  organizationId String
  kind           String // QUALIFIED_NO_FOLLOWUP | STALLED_OPPORTUNITIES | LOW_QUALITY_SOURCE | CPL_INCREASE | RECURRING_OBJECTION | UNANSWERED_QUESTIONS | CONVERSION_DROP | LOSS_PATTERN | CAPACITY
  title          String
  description    String
  severity       String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  sourceData     Json     @default("{}")
  periodStart    DateTime
  periodEnd      DateTime
  confidence     Float
  method         String   @default("RULE")
  status         String   @default("OPEN") // OPEN | ACKNOWLEDGED | DISMISSED
  fingerprint    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, createdAt])
}

model Experiment {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  hypothesis     String?
  target         String // LANDING | HEADLINE | CTA | FORM | MESSAGE | CAMPAIGN | PLAYBOOK | QUALIFICATION_FLOW
  targetId       String?
  campaignId     String?
  primaryMetric  String              @default("OPPORTUNITIES") // LEADS | QUALIFIED | OPPORTUNITIES | CONVERSIONS | REVENUE
  status         String              @default("DRAFT") // DRAFT | RUNNING | PAUSED | COMPLETED
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime            @default(now())
  variants       ExperimentVariant[]

  @@index([organizationId, status])
}

model ExperimentVariant {
  id             String     @id @default(cuid())
  organizationId String
  experimentId   String
  key            String // A | B | C
  name           String
  weight         Int        @default(50)
  config         Json       @default("{}")
  exposures      Int        @default(0)
  spend          Int        @default(0)
  experiment     Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, key])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  enabled        Boolean  @default(false)
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
}

model SavedFilter {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  page           String
  name           String
  query          String
  createdAt      DateTime @default(now())

  @@index([userId, page])
}

model ConfigHistory {
  id             String   @id @default(cuid())
  organizationId String
  area           String // settings | scoring | routing | playbook | prompt | flags
  before         Json
  after          Json
  actorId        String?
  actorName      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, area, createdAt])
}

// Outbox: o evento é gravado na mesma transação da mudança e despachado depois (sem perda).
model OutboxEvent {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  payload        Json
  status         String    @default("PENDING") // PENDING | DISPATCHED | FAILED
  attempts       Int       @default(0)
  lastError      String?
  availableAt    DateTime  @default(now())
  dispatchedAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, availableAt])
}

model JobRun {
  id             String    @id @default(cuid())
  organizationId String?
  job            String
  idempotencyKey String?   @unique
  status         String    @default("RUNNING") // RUNNING | COMPLETED | FAILED | DEAD
  attempts       Int       @default(1)
  error          String?
  durationMs     Int?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([job, startedAt])
  @@index([status])
}

// ═════════════════════════ V2 — Notificações multi-dispositivo ═════════════════════════

model NotificationPreference {
  id                        String   @id @default(cuid())
  organizationId            String
  userId                    String   @unique
  // categoria → canais. Ex.: { "lead.hot": ["IN_APP","DESKTOP","PUSH"] }
  matrix                    Json     @default("{}")
  quietEnabled              Boolean  @default(false)
  quietStart                String   @default("22:00")
  quietEnd                  String   @default("07:00")
  // Exceções que furam o silêncio
  quietBypass               String[] @default(["lead.hot", "sla.critical", "system.critical"])
  hideSensitiveOnLockScreen Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  kind           String // BROWSER | PWA | EXTENSION | MOBILE
  label          String
  os             String?
  browser        String?
  // Web Push: endpoint + chaves públicas do navegador
  pushEndpoint   String?   @unique
  pushP256dh     String?
  pushAuth       String?
  // Extensão: token próprio (somente o hash), revogável
  tokenHash      String?   @unique
  status         String    @default("ACTIVE") // ACTIVE | REVOKED
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model DeepLink {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  // Hash do código curto — o código em si nunca é salvo
  codeHash       String    @unique
  targetType     String // CONVERSATION | LEAD | OPPORTUNITY | TASK
  targetId       String
  method         String // QR | LINK | PUSH
  expiresAt      DateTime
  usedAt         DateTime?
  usedByDevice   String?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── Plataforma (Super Admin) ─────────────────────────

/// Chaves de API configuradas no painel do Super Admin (criptografadas com AES-256-GCM).
/// Têm prioridade sobre o .env. O valor nunca volta para a tela — só os 4 últimos caracteres.
model PlatformCredential {
  key       String   @id
  valueEnc  String
  last4     String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Treinamento da equipe ─────────────────────────

/// Conteúdo de treinamento (vídeo, apostila ou link) cadastrado pelo Super Admin.
model TrainingItem {
  id             String             @id @default(cuid())
  organizationId String
  title          String
  description    String?
  url            String
  category       String             @default("Geral")
  order          Int                @default(0)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  progress       TrainingProgress[]

  @@index([organizationId, active, order])
}

/// Quem concluiu cada conteúdo.
model TrainingProgress {
  id             String       @id @default(cuid())
  organizationId String
  itemId         String
  userId         String
  completedAt    DateTime     @default(now())
  item           TrainingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([organizationId, userId])
}

/// KIT DE DIVULGAÇÃO: modelos de postagem que a gestão revisa e aprova. O consultor recebe alguns por dia,
/// já com o link dele (rastreado por canal). Texto com {link} e {primeiro_nome}. Nada de taxa/valor inventado.
model PostTemplate {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  /// WHATSAPP_STATUS | INSTAGRAM | GRUPOS | QUALQUER
  network        String   @default("QUALQUER")
  /// Público (ex.: "Brasileiros no exterior") — só para orientar quem posta.
  audience       String?
  product        String?
  body           String
  active         Boolean  @default(true)
  /// Só modelos aprovados pela gestão aparecem no kit do consultor.
  approved       Boolean  @default(false)
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, active, approved])
}

/// LINK RASTREADO do consultor: um canal onde ele divulga (grupo, status, Instagram) ou a indicação de um cliente.
/// Vai no utm_campaign (code); o lead que chega por ele mostra de onde veio.
model TrackedLink {
  id             String   @id @default(cuid())
  organizationId String
  consultantId   String
  /// CANAL | INDICACAO
  kind           String   @default("CANAL")
  /// Nome do canal ("Grupo Brasileiros em Lisboa") ou de quem indicou.
  name           String
  /// WHATSAPP_STATUS | INSTAGRAM | GRUPOS | FACEBOOK | OUTRO | INDICACAO
  network        String   @default("OUTRO")
  /// PROPRIO (lead é do consultor) | MESTRE (site mestre, divisão igual)
  target         String   @default("PROPRIO")
  code           String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([organizationId, consultantId])
}
