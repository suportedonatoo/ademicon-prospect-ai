{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prospect-ai",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3500
    },
    {
      "name": "prospect-ai-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3500
    },
    {
      "name": "prospect-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/landing",
        "run",
        "dev"
      ],
      "port": 3600
    }
  ]
}
