# Serviço de Landing Pages das PJs
# URL do sistema de gestão (API /api/v1/landing-service/*)
GESTAO_API_URL=http://localhost:3500
# API key com a permissão landing.service (mesmo valor de LANDING_SERVICE_API_KEY do sistema de gestão)
LANDING_SERVICE_API_KEY=
# Domínio base: cada PJ atende em <subdominio>.<LANDING_BASE_DOMAIN>
# Em desenvolvimento: localhost  →  http://jundiai-centro.localhost:3600
LANDING_BASE_DOMAIN=localhost
# Link "Área do parceiro" (login da plataforma de gestão). Padrão: GESTAO_API_URL + /login
GESTAO_PUBLIC_URL=
# Logo OFICIAL da marca (URL https ou caminho em /public). Sem isso, a página mostra o nome da marca.
LANDING_LOGO_URL=
LANDING_LOGO_URL_WHITE=
