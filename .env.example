# ------------------------------------------------------------------
# Ademicon Prospect AI — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite credenciais reais.
# ------------------------------------------------------------------

# development | staging | production
APP_ENV=development
APP_NAME="Ademicon Prospect AI"
APP_URL=http://localhost:3500
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Chave para criptografar as chaves de API salvas no painel (vazio = deriva do SESSION_SECRET)
CREDENTIALS_KEY=

DATABASE_URL=postgresql://prospect:prospect_dev_password@localhost:5434/prospect
REDIS_URL=redis://localhost:6380

# inline = processa na hora, sem Redis (útil em dev/testes)
# bullmq = filas reais com Redis + worker (npm run worker)
QUEUE_DRIVER=inline

# IA — MODO GRÁTIS: mock = chatbot por roteiro (sem custo). Para IA real: AI_PROVIDER=anthropic (Claude) ou gemini (Google) + AI_API_KEY.
# Modelos: claude-haiku-4-5 (mais barato) | claude-sonnet-5-5 | claude-opus-5-5 (mais capaz).
# Tudo isso também pode ser configurado no painel: Super Admin → Configurar APIs (tem prioridade sobre o .env).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-haiku-4-5
# Chat anônimo da página: roteiro (grátis) | ia
AI_VISITOR_MODE=roteiro
# hash (local, sem custo) | voyage (futuro)
EMBEDDING_PROVIDER=hash

# local | s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_LOCAL_DIR=./storage

# mock | cloud-api
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
# Chave do webhook dos formulários de lead do Google Ads
GOOGLE_ADS_LEAD_FORM_KEY=

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_VERIFY_TOKEN=
META_API_VERSION=v23.0
# Instagram Direct (token da página com instagram_manage_messages)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

GOOGLE_MAPS_API_KEY=
BING_MAPS_API_KEY=

COMPANY_REGISTRY_API_URL=
COMPANY_REGISTRY_API_KEY=
# Consulta de CNPJ: brasilapi (pública e gratuita) | mock
COMPANY_REGISTRY_PROVIDER=brasilapi

# Serviço de landing das PJs (apps/landing). O seed cria a API key com este valor
# (permissão landing.service). Use o MESMO valor em apps/landing/.env.local.
# Gere com: node -e "console.log('pk_'+require('crypto').randomBytes(24).toString('base64url'))"
LANDING_SERVICE_API_KEY=
# Endereço público de cada landing ({subdomain} = subdomínio da PJ). Produção: https://{subdomain}.seudominio.com.br
LANDING_URL_TEMPLATE=http://{subdomain}.localhost:3600
# Site mestre (divisão igual). Vazio = domínio principal do template acima (ex.: http://localhost:3600)
# LANDING_CENTRAL_URL=https://seudominio.com.br

# Segurança
# App Secret da plataforma oficial do WhatsApp: valida a assinatura (X-Hub-Signature-256) das mensagens recebidas.
# Obrigatório com WHATSAPP_PROVIDER=cloud-api ou em produção — sem ele o webhook recusa as mensagens.
WHATSAPP_APP_SECRET=
# ID da conta WhatsApp Business (WABA) — templates e verificação da conta
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Quantos proxies confiáveis (load balancer/CDN) ficam na frente do app (define o IP real do cliente).
TRUSTED_PROXY_HOPS=1

# Web Push (VAPID). Gere com: npx web-push generate-vapid-keys  (sem chaves o canal Push fica NOT_CONFIGURED)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@suaempresa.com.br
# E-mail: none | log (dev: registra no log, não envia)
EMAIL_PROVIDER=none
# Validade (min) dos links "Enviar para meu celular"
DEEP_LINK_TTL_MINUTES=10
# Origens da extensão autorizadas (separadas por vírgula), ex.: chrome-extension://abcdef...
EXTENSION_ORIGINS=
# Login do Instagram: cada consultor conecta a própria conta em Meu perfil (app do Instagram na Meta)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
