# ─────────────────────────────────────────────────────────────────────────────
# PRODUÇÃO — copie para .env.production no SERVIDOR (nunca para o git) e preencha.
# Guia: docs/deploy.md
# ─────────────────────────────────────────────────────────────────────────────

# Domínios (o DNS precisa apontar para o servidor: @, * e gestao)
LANDING_DOMAIN=seudominio.com.br
GESTAO_DOMAIN=gestao.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

APP_ENV=production
APP_NAME=Ademicon Prospect AI
APP_URL=https://gestao.seudominio.com.br
LANDING_URL_TEMPLATE=https://{subdomain}.seudominio.com.br
LANDING_CENTRAL_URL=https://seudominio.com.br

# Segredos — gere valores longos e aleatórios (ex.: openssl rand -base64 48)
SESSION_SECRET=
CREDENTIALS_KEY=
POSTGRES_PASSWORD=
# Gerada pelo scripts/preparar-piloto.ts (aparece uma vez)
LANDING_SERVICE_API_KEY=

# Modo grátis do piloto (IA por roteiro + base de conhecimento). Para a Haiku: AI_PROVIDER=anthropic + AI_API_KEY.
AI_PROVIDER=mock
AI_MODEL=claude-haiku-4-5
AI_VISITOR_MODE=roteiro
AI_API_KEY=

# WhatsApp: mock até decidir a API oficial (cloud-api)
WHATSAPP_PROVIDER=mock
STORAGE_PROVIDER=local
EMAIL_PROVIDER=log
COMPANY_REGISTRY_PROVIDER=brasilapi
